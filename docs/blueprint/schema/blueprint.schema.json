{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vadimptr/rust_calculator/docs/blueprint/schema/blueprint.schema.json",
  "title": "Rust Base Blueprint",
  "description": "Чертёж постройки Rust: строительные блоки с позой в мире, как сущности в игре, плюс размещаемые объекты (шкаф, двери) на блоках. Формат 1.0 (дерево attach от корня) читается и переводится в 2.0. См. docs/blueprint/SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "meta",
    "elements"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grade": {
          "$ref": "#/$defs/Grade"
        }
      }
    },
    "elements": {
      "type": "array",
      "description": "Строительные блоки: в 2.0 — с позой в мире (может быть пустым, если в документе есть terrain), в 1.0 — с attach и одним корнем."
    },
    "deployables": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Deployable"
      }
    },
    "terrain": {
      "type": "array",
      "default": [],
      "description": "Объекты окружения из игры (скала God Rock), в которые встраивают постройку. См. SPEC.md §6.1.",
      "items": {
        "$ref": "#/$defs/Terrain"
      }
    },
    "resolved": {
      "$ref": "#/$defs/Resolved"
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "Grade": {
      "type": "string",
      "enum": [
        "twig",
        "wood",
        "stone",
        "metal",
        "armored"
      ]
    },
    "ElementKind": {
      "type": "string",
      "enum": [
        "square-foundation",
        "triangle-foundation",
        "foundation-steps",
        "ramp",
        "wall",
        "half-wall",
        "low-wall",
        "doorway",
        "window-frame",
        "wall-frame",
        "square-floor",
        "triangle-floor",
        "floor-frame",
        "triangle-floor-frame",
        "stairs-l-shape",
        "u-shaped-stairs",
        "spiral-stairs",
        "spiral-stairs-triangle",
        "roof",
        "roof-triangle"
      ]
    },
    "DeployableKind": {
      "type": "string",
      "enum": [
        "tool-cupboard",
        "wooden-door",
        "sheet-metal-door",
        "armored-door",
        "garage-door",
        "wooden-double-door",
        "sheet-metal-double-door",
        "armored-double-door",
        "strengthened-glass-window",
        "reinforced-glass-window",
        "metal-window-bars",
        "metal-embrasure",
        "drop-box"
      ]
    },
    "Socket": {
      "type": "string",
      "pattern": "^(edge:[0-3]|top|bottom|opening|face|offset)$"
    },
    "Vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "Vec2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "gameVersion": {
          "type": "string",
          "description": "Месяц обновления игры, под которое проверен чертёж, например \"2026-09\"."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "Attach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to",
        "socket"
      ],
      "properties": {
        "to": {
          "$ref": "#/$defs/Id"
        },
        "socket": {
          "$ref": "#/$defs/Socket"
        },
        "selfSocket": {
          "$ref": "#/$defs/Socket",
          "description": "Сокет самого элемента, которым он прикладывается. Обязателен для элементов с несколькими подходящими сокетами (фундаменты, полы, крыши)."
        },
        "flip": {
          "type": "boolean",
          "default": false,
          "description": "Для присоединения к сокету top стены: разместить элемент по другую сторону стены. Для крыши на ребре ячейки: внутрь — низким ребром на ребре, скатом над самой ячейкой (без flip — наружу, над соседней позицией)."
        },
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0,
          "description": "Поворот элемента внутри ячейки в четвертях оборота (только для лестниц)."
        },
        "rise": {
          "type": "number",
          "enum": [
            -3,
            -1.5,
            0,
            0.75,
            1.5,
            3
          ],
          "default": 0,
          "description": "Фундамент к фундаменту: сдвиг соседа по высоте в метрах. В игре у фундамента три ряда боковых сокетов (foundation-top/mid/bot) с шагом 1.5 м; верх фундамента — на земле, на высоте полустены или стены (0, 1.5, 3 м). Съезд на верху фундамента или пола: 0 — сокет block-male на block-female (низкий съезд, подъём 0,75 м), 0.75 — misc-male на misc-female (высокий съезд, подъём 1,5 м)."
        },
        "offset": {
          "$ref": "#/$defs/Vec3",
          "description": "Только socket offset: положение [x, y, z] в метрах в системе элемента to (x по его нормали/оси 0°, y вверх)."
        },
        "rotation": {
          "type": "number",
          "description": "Только socket offset: поворот в плане относительно элемента to, градусы."
        }
      }
    },
    "Element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "position",
        "rotation"
      ],
      "description": "Строительный блок с позой в мире, как сущность в игре. Связи между блоками не хранятся: они следуют из совпадения сокетов.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "$ref": "#/$defs/ElementKind"
        },
        "grade": {
          "$ref": "#/$defs/Grade"
        },
        "position": {
          "$ref": "#/$defs/Vec3",
          "description": "Позиция блока в мире, метры, оси Unity: x, y вверх, z."
        },
        "rotation": {
          "type": "number",
          "description": "Поворот вокруг вертикали, градусы (§4.1)."
        },
        "inverted": {
          "type": "boolean",
          "description": "Только треугольная крыша: перевёрнута, ребро edge:0 у конька."
        },
        "bunker": {
          "type": "boolean",
          "description": "Деталь затвора роф-бункера, которую хозяин убирает, чтобы войти: крыша-затвор или твиговая плита-опора под ней. Переключатель «Открыть двери» в просмотре их убирает. Только для крыш и полов."
        },
        "label": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "roof",
                  "roof-triangle",
                  "square-floor",
                  "triangle-floor"
                ]
              }
            }
          },
          "then": {},
          "else": {
            "properties": {
              "bunker": false
            }
          }
        }
      ]
    },
    "LegacyElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "$ref": "#/$defs/ElementKind"
        },
        "grade": {
          "$ref": "#/$defs/Grade"
        },
        "attach": {
          "$ref": "#/$defs/Attach"
        },
        "bunker": {
          "type": "boolean",
          "description": "Деталь затвора роф-бункера, которую хозяин убирает, чтобы войти: крыша-затвор или твиговая плита-опора под ней. Переключатель «Открыть двери» в просмотре их убирает. Только для крыш и полов."
        },
        "label": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "root": {
          "const": true,
          "description": "Корневой фундамент: ячейка, на которой стоит шкаф. Ровно один на документ (единственность проверяет валидатор, V02)."
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position",
            "rotation"
          ],
          "description": "Только для корня: положение и поворот корневого фундамента в мире. Без поля корень стоит в начале координат без поворота.",
          "properties": {
            "position": {
              "$ref": "#/$defs/Vec3"
            },
            "rotation": {
              "type": "number"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "root"
          ],
          "properties": {
            "attach": false
          }
        },
        {
          "required": [
            "attach"
          ],
          "properties": {
            "root": false,
            "origin": false
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "square-foundation",
                  "triangle-foundation"
                ]
              }
            }
          },
          "then": {},
          "else": {
            "properties": {
              "root": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "roof",
                  "roof-triangle",
                  "square-floor",
                  "triangle-floor"
                ]
              }
            }
          },
          "then": {},
          "else": {
            "properties": {
              "bunker": false
            }
          }
        }
      ],
      "description": "Блок документа 1.0: держится за сокет другого блока (attach), один корень стоит в начале координат. Загружается переводом в 2.0."
    },
    "Deployable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "attach"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "$ref": "#/$defs/DeployableKind"
        },
        "attach": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "to",
            "socket"
          ],
          "properties": {
            "to": {
              "$ref": "#/$defs/Id"
            },
            "socket": {
              "type": "string",
              "enum": [
                "top",
                "opening",
                "face"
              ]
            }
          }
        },
        "offset": {
          "$ref": "#/$defs/Vec2",
          "description": "Шкаф: смещение [x, z] в метрах от центра ячейки. Дроп-бокс: [вдоль стены, высота] от середины низа стены."
        },
        "rotation": {
          "type": "number",
          "default": 0,
          "description": "Угол в градусах относительно родительской ячейки (только для сокета top)."
        },
        "hinge": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "Сторона петель, глядя снаружи (по нормали проёма). Только для дверей."
        },
        "label": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "opens": {
          "type": "string",
          "enum": [
            "outward",
            "inward"
          ],
          "default": "outward",
          "description": "Куда распахивается дверь: outward — по нормали проёма (наружу), inward — против нормали. Только для дверей."
        },
        "open": {
          "type": "boolean",
          "default": false,
          "description": "Дверь показана открытой (для просмотра и проверки перекрытия). Только для дверей."
        },
        "direction": {
          "type": "string",
          "enum": [
            "in",
            "out"
          ],
          "description": "Только для дроп-бокса: out — передача изнутри наружу (по нормали стены), in — снаружи внутрь."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool-cupboard"
              }
            }
          },
          "then": {
            "properties": {
              "attach": {
                "type": "object",
                "properties": {
                  "socket": {
                    "const": "top"
                  }
                }
              },
              "hinge": false,
              "opens": false,
              "open": false,
              "direction": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "drop-box"
              }
            }
          },
          "then": {
            "properties": {
              "attach": {
                "type": "object",
                "properties": {
                  "socket": {
                    "const": "face"
                  }
                }
              },
              "hinge": false,
              "opens": false,
              "open": false,
              "rotation": false
            },
            "required": [
              "direction"
            ]
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "kind": {
                  "enum": [
                    "tool-cupboard",
                    "drop-box"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "attach": {
                "type": "object",
                "properties": {
                  "socket": {
                    "const": "opening"
                  }
                }
              },
              "offset": false,
              "rotation": false,
              "direction": false
            }
          }
        }
      ]
    },
    "Terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "position",
        "rotation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "god-rock"
          ],
          "description": "god-rock — v3_rock_formations_large/rock_formation_a.prefab, скала со сквозной полостью."
        },
        "position": {
          "$ref": "#/$defs/Vec3",
          "description": "Точка префаба на земле, мировые координаты."
        },
        "rotation": {
          "type": "number",
          "description": "Поворот в плане, градусы (§4.1). В игре случайный от −180 до 180."
        },
        "scale": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.2,
          "default": 1,
          "description": "Масштаб генерации мира (DecorScale), одинаковый по осям."
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "ResolvedTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "rotation",
        "level"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec3"
        },
        "rotation": {
          "type": "number"
        },
        "level": {
          "type": "number",
          "multipleOf": 0.5
        },
        "sockets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "normal"
            ],
            "properties": {
              "position": {
                "$ref": "#/$defs/Vec3"
              },
              "normal": {
                "$ref": "#/$defs/Vec2"
              }
            }
          }
        }
      }
    },
    "Resolved": {
      "description": "Вычисляемый слой. Никогда не редактируется руками; пересчитывается движком геометрии.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "sourceHash",
        "elements"
      ],
      "properties": {
        "generator": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "elements": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ResolvedTransform"
          }
        },
        "deployables": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ResolvedTransform"
          }
        },
        "adjacency": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "b"
            ],
            "properties": {
              "a": {
                "$ref": "#/$defs/SocketRef"
              },
              "b": {
                "$ref": "#/$defs/SocketRef"
              }
            }
          }
        }
      }
    },
    "SocketRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "socket"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "socket": {
          "$ref": "#/$defs/Socket"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "formatVersion": {
            "const": "1.0"
          }
        },
        "required": [
          "formatVersion"
        ]
      },
      "then": {
        "properties": {
          "elements": {
            "items": {
              "$ref": "#/$defs/LegacyElement"
            },
            "type": "array",
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "elements": {
            "items": {
              "$ref": "#/$defs/Element"
            },
            "type": "array"
          }
        }
      }
    }
  ]
}
