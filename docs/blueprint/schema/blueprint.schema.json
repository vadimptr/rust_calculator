{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vadimptr/rust_calculator/docs/blueprint/schema/blueprint.schema.json",
  "title": "Rust Base Blueprint",
  "description": "Чертёж постройки Rust: граф строительных блоков, соединённых через сокеты, плюс размещаемые объекты (шкаф, двери). См. docs/blueprint/SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "meta",
    "elements"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "const": "1.0"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grade": {
          "$ref": "#/$defs/Grade"
        }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Element"
      },
      "description": "Строительные блоки. Ровно один элемент помечен root: true, остальные имеют attach."
    },
    "deployables": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Deployable"
      }
    },
    "raidPath": {
      "description": "Упорядоченный список id элементов и объектов, которые рейдер разрушает по пути к цели.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      },
      "uniqueItems": true
    },
    "resolved": {
      "$ref": "#/$defs/Resolved"
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "Grade": {
      "type": "string",
      "enum": [
        "twig",
        "wood",
        "stone",
        "metal",
        "armored"
      ]
    },
    "ElementKind": {
      "type": "string",
      "enum": [
        "square-foundation",
        "triangle-foundation",
        "wall",
        "half-wall",
        "low-wall",
        "doorway",
        "window-frame",
        "wall-frame",
        "square-floor",
        "triangle-floor",
        "floor-frame",
        "triangle-floor-frame",
        "stairs-l-shape",
        "u-shaped-stairs",
        "roof",
        "roof-triangle"
      ]
    },
    "DeployableKind": {
      "type": "string",
      "enum": [
        "tool-cupboard",
        "wooden-door",
        "sheet-metal-door",
        "armored-door",
        "garage-door",
        "wooden-double-door",
        "sheet-metal-double-door",
        "armored-double-door",
        "strengthened-glass-window",
        "reinforced-glass-window",
        "metal-window-bars"
      ]
    },
    "Socket": {
      "type": "string",
      "pattern": "^(edge:[0-3]|top|bottom|opening)$"
    },
    "Vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "Vec2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "gameVersion": {
          "type": "string",
          "description": "Месяц обновления игры, под которое проверен чертёж, например \"2026-09\"."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "Attach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to",
        "socket"
      ],
      "properties": {
        "to": {
          "$ref": "#/$defs/Id"
        },
        "socket": {
          "$ref": "#/$defs/Socket"
        },
        "selfSocket": {
          "$ref": "#/$defs/Socket",
          "description": "Сокет самого элемента, которым он прикладывается. Обязателен для элементов с несколькими подходящими сокетами (фундаменты, полы, крыши)."
        },
        "flip": {
          "type": "boolean",
          "default": false,
          "description": "Для присоединения к сокету top стены: разместить элемент по другую сторону стены."
        },
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0,
          "description": "Поворот элемента внутри ячейки в четвертях оборота (только для лестниц)."
        }
      }
    },
    "Element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "$ref": "#/$defs/ElementKind"
        },
        "grade": {
          "$ref": "#/$defs/Grade"
        },
        "attach": {
          "$ref": "#/$defs/Attach"
        },
        "label": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "root": {
          "const": true,
          "description": "Корневой фундамент: ячейка, на которой стоит шкаф. Ровно один на документ (единственность проверяет валидатор, V02)."
        }
      },
      "oneOf": [
        {
          "required": [
            "root"
          ],
          "properties": {
            "attach": false
          }
        },
        {
          "required": [
            "attach"
          ],
          "properties": {
            "root": false
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "square-foundation",
                  "triangle-foundation"
                ]
              }
            }
          },
          "then": {},
          "else": {
            "properties": {
              "root": false
            }
          }
        }
      ]
    },
    "Deployable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "attach"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "$ref": "#/$defs/DeployableKind"
        },
        "attach": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "to",
            "socket"
          ],
          "properties": {
            "to": {
              "$ref": "#/$defs/Id"
            },
            "socket": {
              "type": "string",
              "enum": [
                "top",
                "opening"
              ]
            }
          }
        },
        "offset": {
          "$ref": "#/$defs/Vec2",
          "description": "Смещение [x, z] в метрах от центра ячейки (только для сокета top)."
        },
        "rotation": {
          "type": "number",
          "default": 0,
          "description": "Угол в градусах относительно родительской ячейки (только для сокета top)."
        },
        "hinge": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "Сторона петель, глядя снаружи (по нормали проёма). Только для дверей."
        },
        "label": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "opens": {
          "type": "string",
          "enum": [
            "outward",
            "inward"
          ],
          "default": "outward",
          "description": "Куда распахивается дверь: outward — по нормали проёма (наружу), inward — против нормали. Только для дверей."
        },
        "open": {
          "type": "boolean",
          "default": false,
          "description": "Дверь показана открытой (для просмотра и проверки перекрытия). Только для дверей."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool-cupboard"
              }
            }
          },
          "then": {
            "properties": {
              "attach": {
                "type": "object",
                "properties": {
                  "socket": {
                    "const": "top"
                  }
                }
              },
              "hinge": false,
              "opens": false,
              "open": false
            }
          },
          "else": {
            "properties": {
              "attach": {
                "type": "object",
                "properties": {
                  "socket": {
                    "const": "opening"
                  }
                }
              },
              "offset": false,
              "rotation": false
            }
          }
        }
      ]
    },
    "ResolvedTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "rotation",
        "level"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec3"
        },
        "rotation": {
          "type": "number"
        },
        "level": {
          "type": "number",
          "multipleOf": 0.5
        },
        "sockets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "normal"
            ],
            "properties": {
              "position": {
                "$ref": "#/$defs/Vec3"
              },
              "normal": {
                "$ref": "#/$defs/Vec2"
              }
            }
          }
        }
      }
    },
    "Resolved": {
      "description": "Вычисляемый слой. Никогда не редактируется руками; пересчитывается движком геометрии.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "sourceHash",
        "elements"
      ],
      "properties": {
        "generator": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "elements": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ResolvedTransform"
          }
        },
        "deployables": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ResolvedTransform"
          }
        },
        "adjacency": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "b"
            ],
            "properties": {
              "a": {
                "$ref": "#/$defs/SocketRef"
              },
              "b": {
                "$ref": "#/$defs/SocketRef"
              }
            }
          }
        }
      }
    },
    "SocketRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "socket"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "socket": {
          "$ref": "#/$defs/Socket"
        }
      }
    }
  }
}
