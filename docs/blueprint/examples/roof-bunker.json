{
  "$schema": "../schema/blueprint.schema.json",
  "formatVersion": "1.0",
  "meta": {
    "name": "Роф-бункер",
    "description": "Классический роф-бункер на стабильности. Комната шкафа из двух ячеек; её вторая ячейка отделена от тамбура каменной полустеной. На верх полустены внутри комнаты положена твиговая плита на половинной высоте, а на её ребро поставлена каменная крыша: низкое ребро на высоте полустены над тамбуром, скат поднимается к двери сквозь потолок тамбура. Над полустеной проход закрыт крышей, под крышей — полустеной. Снаружи до твига не добраться: он за крышей и за дверью. Хозяин изнутри ломает твиговую плиту, крыша теряет опору и падает, проход над полустеной открыт; потом плита и крыша ставятся заново.",
    "gameVersion": "2026-09",
    "tags": [
      "tc",
      "bunker",
      "example"
    ]
  },
  "defaults": {
    "grade": "stone"
  },
  "elements": [
    {
      "id": "f1",
      "kind": "square-foundation",
      "root": true,
      "label": "Ячейка шкафа"
    },
    {
      "id": "w1",
      "kind": "wall",
      "attach": {
        "to": "f1",
        "socket": "edge:1"
      }
    },
    {
      "id": "w2",
      "kind": "wall",
      "attach": {
        "to": "f1",
        "socket": "edge:2"
      }
    },
    {
      "id": "w3",
      "kind": "wall",
      "attach": {
        "to": "f1",
        "socket": "edge:3"
      }
    },
    {
      "id": "c1",
      "kind": "square-floor",
      "attach": {
        "to": "w2",
        "socket": "top",
        "selfSocket": "edge:0"
      },
      "label": "Потолок над шкафом"
    },
    {
      "id": "f3",
      "kind": "square-foundation",
      "attach": {
        "to": "f1",
        "socket": "edge:0",
        "selfSocket": "edge:2"
      },
      "label": "Ячейка затвора"
    },
    {
      "id": "w6",
      "kind": "wall",
      "attach": {
        "to": "f3",
        "socket": "edge:1"
      }
    },
    {
      "id": "w7",
      "kind": "wall",
      "attach": {
        "to": "f3",
        "socket": "edge:3"
      }
    },
    {
      "id": "hw",
      "kind": "half-wall",
      "attach": {
        "to": "f3",
        "socket": "edge:0"
      },
      "label": "Полустена к тамбуру"
    },
    {
      "id": "c3",
      "kind": "square-floor",
      "attach": {
        "to": "w6",
        "socket": "top",
        "selfSocket": "edge:0"
      },
      "label": "Потолок ячейки затвора"
    },
    {
      "id": "tf",
      "kind": "square-floor",
      "grade": "twig",
      "bunker": true,
      "attach": {
        "to": "hw",
        "socket": "top",
        "selfSocket": "edge:0"
      },
      "label": "Твиговая опора",
      "notes": "Плита на половинной высоте внутри ячейки затвора. Хозяин ломает её, чтобы уронить крышу-затвор."
    },
    {
      "id": "rb",
      "kind": "roof",
      "bunker": true,
      "attach": {
        "to": "tf",
        "socket": "edge:0",
        "selfSocket": "edge:0"
      },
      "label": "Крыша-затвор",
      "notes": "Низкое ребро на ребре твиговой плиты над полустеной, скат над тамбуром к двери сквозь его потолок."
    },
    {
      "id": "f2",
      "kind": "square-foundation",
      "attach": {
        "to": "f3",
        "socket": "edge:0",
        "selfSocket": "edge:2"
      },
      "label": "Тамбур"
    },
    {
      "id": "w4",
      "kind": "wall",
      "attach": {
        "to": "f2",
        "socket": "edge:1"
      }
    },
    {
      "id": "w5",
      "kind": "wall",
      "attach": {
        "to": "f2",
        "socket": "edge:3"
      }
    },
    {
      "id": "dw",
      "kind": "doorway",
      "attach": {
        "to": "f2",
        "socket": "edge:0"
      },
      "label": "Вход"
    },
    {
      "id": "c2",
      "kind": "square-floor",
      "attach": {
        "to": "w4",
        "socket": "top",
        "selfSocket": "edge:0"
      },
      "label": "Потолок тамбура"
    }
  ],
  "deployables": [
    {
      "id": "tc1",
      "kind": "tool-cupboard",
      "attach": {
        "to": "f1",
        "socket": "top"
      },
      "offset": [
        -0.9,
        -0.9
      ],
      "rotation": 45,
      "notes": "В дальнем углу у стен w2 и w3."
    },
    {
      "id": "d1",
      "kind": "sheet-metal-door",
      "attach": {
        "to": "dw",
        "socket": "opening"
      },
      "hinge": "left",
      "opens": "outward"
    }
  ]
}
