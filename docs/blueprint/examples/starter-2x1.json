{
  "$schema": "../schema/blueprint.schema.json",
  "formatVersion": "1.0",
  "meta": {
    "name": "Дом 2×1",
    "description": "Два квадратных фундамента, стены по периметру, дверной проём с металлической дверью, перекрытие и шкаф в корневой ячейке.",
    "gameVersion": "2026-09",
    "tags": [
      "starter",
      "example"
    ]
  },
  "defaults": {
    "grade": "stone"
  },
  "elements": [
    {
      "id": "f1",
      "kind": "square-foundation",
      "root": true
    },
    {
      "id": "f2",
      "kind": "square-foundation",
      "attach": {
        "to": "f1",
        "socket": "edge:0",
        "selfSocket": "edge:2"
      }
    },
    {
      "id": "d1",
      "kind": "doorway",
      "grade": "metal",
      "attach": {
        "to": "f1",
        "socket": "edge:2"
      }
    },
    {
      "id": "w1",
      "kind": "wall",
      "attach": {
        "to": "f1",
        "socket": "edge:1"
      }
    },
    {
      "id": "w2",
      "kind": "wall",
      "attach": {
        "to": "f1",
        "socket": "edge:3"
      }
    },
    {
      "id": "w3",
      "kind": "wall",
      "attach": {
        "to": "f2",
        "socket": "edge:0"
      }
    },
    {
      "id": "w4",
      "kind": "wall",
      "attach": {
        "to": "f2",
        "socket": "edge:1"
      }
    },
    {
      "id": "w5",
      "kind": "wall",
      "attach": {
        "to": "f2",
        "socket": "edge:3"
      }
    },
    {
      "id": "c1",
      "kind": "square-floor",
      "attach": {
        "to": "w1",
        "socket": "top",
        "selfSocket": "edge:1"
