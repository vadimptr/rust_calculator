  "deployables": [
    {
      "id": "door1",
      "kind": "sheet-metal-door",
      "attach": {
        "to": "d1",
        "socket": "opening"
      },
      "hinge": "right"
    },
    {
      "id": "tc1",
      "kind": "tool-cupboard",
      "attach": {
        "to": "f1",
        "socket": "top"
      },
      "offset": [
        -0.8,
        -0.8
      ],
      "rotation": 45
    }
  ],
  "raidPath": [
    "door1"
  ]
