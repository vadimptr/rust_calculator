{
  "$schema": "../schema/blueprint.schema.json",
  "formatVersion": "1.0",
  "meta": {
    "name": "Дом с отстрелами",
    "description": "2×2 с набором оборонительных позиций. Первый этаж: тамбур с входной дверью, комната со шкафом за двойной дверью, окно с решёткой во второй комнате. Второй этаж — отстрельный: квадратный пикдаун над входной дверью и треугольный пикдаун на углу, оба с низкими стенами по краю; полустены по открытым сторонам для стрельбы в присяде; окно с решёткой над ячейкой с окном. Крыша с низкими стенами по периметру как крышный отстрел, выход на неё через раму пола с полустены.",
    "gameVersion": "2026-09",
    "tags": ["2x2", "peek-down", "defense", "example"]
  },
  "defaults": { "grade": "stone" },
  "elements": [
    { "id": "f1", "kind": "square-foundation", "root": true, "label": "Комната со шкафом" },
    { "id": "f2", "kind": "square-foundation", "attach": { "to": "f1", "socket": "edge:0", "selfSocket": "edge:2" }, "label": "Тамбур" },
    { "id": "f3", "kind": "square-foundation", "attach": { "to": "f1", "socket": "edge:1", "selfSocket": "edge:3" }, "label": "Комната с окном" },
    { "id": "f4", "kind": "square-foundation", "attach": { "to": "f2", "socket": "edge:1", "selfSocket": "edge:3" }, "label": "Вторая комната" },

    { "id": "w1", "kind": "wall", "attach": { "to": "f1", "socket": "edge:2" } },
    { "id": "w2", "kind": "wall", "attach": { "to": "f1", "socket": "edge:3" } },
    { "id": "w3", "kind": "wall", "attach": { "to": "f1", "socket": "edge:1" } },
    { "id": "fr_tc", "kind": "wall-frame", "grade": "metal", "attach": { "to": "f1", "socket": "edge:0" }, "label": "Рама под двойную дверь шкафа" },

    { "id": "d_ext", "kind": "doorway", "grade": "metal", "attach": { "to": "f2", "socket": "edge:0" }, "label": "Входная дверь" },
    { "id": "w4", "kind": "wall", "attach": { "to": "f2", "socket": "edge:3" } },
    { "id": "d_f4", "kind": "doorway", "grade": "metal", "attach": { "to": "f2", "socket": "edge:1" }, "label": "Дверь во вторую комнату" },

    { "id": "win_g", "kind": "window-frame", "attach": { "to": "f3", "socket": "edge:2" }, "label": "Окно первого этажа с решёткой" },
    { "id": "w5", "kind": "wall", "attach": { "to": "f3", "socket": "edge:1" } },
    { "id": "w6", "kind": "wall", "attach": { "to": "f3", "socket": "edge:0" }, "label": "Стена между комнатами" },

    { "id": "w7", "kind": "wall", "attach": { "to": "f4", "socket": "edge:0" } },
    { "id": "w8", "kind": "wall", "attach": { "to": "f4", "socket": "edge:1" } },

    { "id": "c1", "kind": "square-floor", "attach": { "to": "w1", "socket": "top", "selfSocket": "edge:2" } },
    { "id": "c2", "kind": "square-floor", "attach": { "to": "c1", "socket": "edge:0", "selfSocket": "edge:2" } },
    { "id": "c3", "kind": "square-floor", "attach": { "to": "c1", "socket": "edge:1", "selfSocket": "edge:3" } },
    { "id": "c4", "kind": "square-floor", "attach": { "to": "c2", "socket": "edge:1", "selfSocket": "edge:3" } },

    { "id": "pk_door", "kind": "square-floor", "attach": { "to": "c2", "socket": "edge:0", "selfSocket": "edge:2" }, "label": "Пикдаун над входной дверью", "notes": "Пол выступает за стену: с края простреливаются дверь и стена под ним." },
    { "id": "lw_pk1", "kind": "low-wall", "attach": { "to": "pk_door", "socket": "edge:0" }, "label": "Укрытие пикдауна" },
    { "id": "lw_pk2", "kind": "low-wall", "attach": { "to": "pk_door", "socket": "edge:1" }, "label": "Укрытие пикдауна" },
    { "id": "lw_pk3", "kind": "low-wall", "attach": { "to": "pk_door", "socket": "edge:3" }, "label": "Укрытие пикдауна" },

    { "id": "pk_tri", "kind": "triangle-floor", "attach": { "to": "c4", "socket": "edge:1", "selfSocket": "edge:0" }, "label": "Треугольный пикдаун на углу" },
    { "id": "lw_pk4", "kind": "low-wall", "attach": { "to": "pk_tri", "socket": "edge:1" }, "label": "Укрытие пикдауна" },
    { "id": "lw_pk5", "kind": "low-wall", "attach": { "to": "pk_tri", "socket": "edge:2" }, "label": "Укрытие пикдауна" },

    { "id": "u1", "kind": "wall", "attach": { "to": "c1", "socket": "edge:2" } },
    { "id": "u2", "kind": "wall", "attach": { "to": "c1", "socket": "edge:3" } },
    { "id": "u3", "kind": "wall", "attach": { "to": "c1", "socket": "edge:0" }, "label": "Стена над шкафом к отстрельному этажу" },
    { "id": "u4", "kind": "wall", "attach": { "to": "c1", "socket": "edge:1" } },
    { "id": "win_u", "kind": "window-frame", "attach": { "to": "c3", "socket": "edge:2" }, "label": "Окно отстрельного этажа с решёткой" },
    { "id": "u5", "kind": "wall", "attach": { "to": "c3", "socket": "edge:1" } },
    { "id": "u6", "kind": "wall", "attach": { "to": "c3", "socket": "edge:0" } },
    { "id": "hw1", "kind": "half-wall", "attach": { "to": "c2", "socket": "edge:3" }, "label": "Полустена для стрельбы в присяде" },
    { "id": "hw2", "kind": "half-wall", "attach": { "to": "c4", "socket": "edge:0" }, "label": "Полустена для стрельбы в присяде и запрыг на крышу" },

    { "id": "r1", "kind": "square-floor", "attach": { "to": "u1", "socket": "top", "selfSocket": "edge:2" }, "label": "Крыша" },
    { "id": "r2", "kind": "square-floor", "attach": { "to": "r1", "socket": "edge:0", "selfSocket": "edge:2" }, "label": "Крыша" },
    { "id": "r3", "kind": "square-floor", "attach": { "to": "r1", "socket": "edge:1", "selfSocket": "edge:3" }, "label": "Крыша" },
    { "id": "r4", "kind": "floor-frame", "attach": { "to": "r2", "socket": "edge:1", "selfSocket": "edge:3" }, "label": "Выход на крышу с полустены" },

    { "id": "lw_r1", "kind": "low-wall", "attach": { "to": "r1", "socket": "edge:2" }, "label": "Крышный отстрел" },
    { "id": "lw_r2", "kind": "low-wall", "attach": { "to": "r1", "socket": "edge:3" }, "label": "Крышный отстрел" },
    { "id": "lw_r3", "kind": "low-wall", "attach": { "to": "r2", "socket": "edge:0" }, "label": "Крышный отстрел" },
    { "id": "lw_r4", "kind": "low-wall", "attach": { "to": "r2", "socket": "edge:3" }, "label": "Крышный отстрел" },
    { "id": "lw_r5", "kind": "low-wall", "attach": { "to": "r3", "socket": "edge:2" }, "label": "Крышный отстрел" },
    { "id": "lw_r6", "kind": "low-wall", "attach": { "to": "r3", "socket": "edge:1" }, "label": "Крышный отстрел" },
    { "id": "lw_r7", "kind": "low-wall", "attach": { "to": "r4", "socket": "edge:0" }, "label": "Крышный отстрел" },
    { "id": "lw_r8", "kind": "low-wall", "attach": { "to": "r4", "socket": "edge:1" }, "label": "Крышный отстрел" }
  ],
  "deployables": [
    { "id": "door_ext", "kind": "sheet-metal-door", "attach": { "to": "d_ext", "socket": "opening" }, "hinge": "left" },
    { "id": "door_tc", "kind": "sheet-metal-double-door", "attach": { "to": "fr_tc", "socket": "opening" }, "opens": "outward" },
    { "id": "door_f4", "kind": "sheet-metal-door", "attach": { "to": "d_f4", "socket": "opening" }, "hinge": "left" },
    { "id": "bars_g", "kind": "metal-window-bars", "attach": { "to": "win_g", "socket": "opening" } },
    { "id": "bars_u", "kind": "metal-window-bars", "attach": { "to": "win_u", "socket": "opening" } },
    { "id": "tc1", "kind": "tool-cupboard", "attach": { "to": "f1", "socket": "top" }, "offset": [-1.075, -0.825], "rotation": 0, "notes": "Прижат спинкой и боком к стенам дальнего угла." }
  ]
}
