{
  "$schema": "../schema/blueprint.schema.json",
  "formatVersion": "1.0",
  "meta": {
    "name": "Дом 2×2 с запрыгом",
    "description": "Классический 2×2. Первый этаж: вход в тамбур, из тамбура двери в комнату со шкафом и во вторую комнату, итого три двери. Из комнаты со шкафом открытый проём в комнату с запрыгом: полустена под рамой пола ведёт на второй этаж. Наверху комната над двумя ячейками и дверь на крышу-террасу с низкими стенками.",
    "gameVersion": "2026-09",
    "tags": [
      "starter",
      "2x2",
      "jump-up",
      "example"
    ]
  },
  "defaults": {
    "grade": "stone"
  },
  "elements": [
    {
      "id": "f1",
      "kind": "square-foundation",
      "root": true,
      "label": "Комната со шкафом"
    },
    {
      "id": "f2",
      "kind": "square-foundation",
      "attach": {
        "to": "f1",
        "socket": "edge:0",
        "selfSocket": "edge:2"
      },
      "label": "Тамбур"
    },
    {
      "id": "f3",
      "kind": "square-foundation",
      "attach": {
        "to": "f1",
        "socket": "edge:1",
        "selfSocket": "edge:3"
      },
      "label": "Комната с запрыгом"
    },
    {
      "id": "f4",
