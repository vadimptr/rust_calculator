      "id": "f1",
      "kind": "square-foundation",
      "root": true,
      "label": "Комната со шкафом"
    },
    {
      "id": "f2",
      "kind": "square-foundation",
      "attach": {
        "to": "f1",
        "socket": "edge:0",
        "selfSocket": "edge:2"
      },
      "label": "Тамбур"
    },
    {
      "id": "f3",
      "kind": "square-foundation",
      "attach": {
        "to": "f2",
        "socket": "edge:1",
        "selfSocket": "edge:3"
      },
