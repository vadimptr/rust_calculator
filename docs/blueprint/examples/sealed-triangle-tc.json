{
  "$schema": "../schema/blueprint.schema.json",
  "formatVersion": "1.0",
  "meta": {
    "name": "Шкаф в треугольном бункере",
    "description": "Шкаф, закатанный в каменный треугольник: треугольный фундамент, три стены, треугольный пол сверху. Двери нет, лут передаётся через два дроп-бокса на стене: изнутри наружу и снаружи внутрь.",
    "gameVersion": "2026-09",
    "tags": [
      "tc",
      "example"
    ]
  },
  "defaults": {
    "grade": "stone"
  },
  "elements": [
    {
      "id": "f1",
      "kind": "triangle-foundation",
      "root": true
    },
    {
      "id": "w1",
      "kind": "wall",
      "attach": {
        "to": "f1",
        "socket": "edge:0"
      }
    },
    {
      "id": "w2",
      "kind": "wall",
      "attach": {
        "to": "f1",
        "socket": "edge:1"
      }
    },
    {
      "id": "w3",
      "kind": "wall",
      "attach": {
        "to": "f1",
        "socket": "edge:2"
      }
    },
    {
      "id": "c1",
      "kind": "triangle-floor",
      "attach": {
        "to": "w1",
        "socket": "top",
        "selfSocket": "edge:0"
      }
    }
  ],
  "deployables": [
    {
      "id": "tc1",
      "kind": "tool-cupboard",
      "attach": {
        "to": "f1",
        "socket": "top"
      },
      "offset": [
        -0.22,
        0.382
      ],
      "rotation": 300,
      "notes": "Спинкой к стене w2, фронтом к центру."
    },
    {
      "id": "box_out",
      "kind": "drop-box",
      "attach": {
        "to": "w1",
        "socket": "face"
      },
      "offset": [
        -0.8,
        1.3
      ],
      "direction": "out",
      "label": "Дроп-бокс изнутри наружу"
    },
    {
      "id": "box_in",
      "kind": "drop-box",
      "attach": {
        "to": "w1",
        "socket": "face"
      },
      "offset": [
        0.8,
        1.3
      ],
      "direction": "in",
      "label": "Дроп-бокс снаружи внутрь"
    }
  ]
}
