{
	dynamic_dns {
		provider cloudflare {env.CF_API_TOKEN}
		domains {
			vadimptr.com home king rust
		}
		check_interval 5m
		versions ipv4
	}
	servers {
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP
	}
}

(cloudflare_tls) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
		client_auth {
			mode require_and_verify
			trusted_ca_cert_file /etc/caddy/origin-pull-ca.pem
		}
	}
	encode gzip
}

https://rust.vadimptr.com:9097 {
	import cloudflare_tls
	reverse_proxy host.docker.internal:9092 {
		header_up X-Real-IP {client_ip}
	}
}

https://king.vadimptr.com:9097 {
	import cloudflare_tls
	reverse_proxy host.docker.internal:9090
}
